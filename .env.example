# Safe defaults: both switches must be changed before any external action.
DEMO_MODE=true
ALLOW_REAL_ACTIONS=false
DATABASE_PATH=./data/ek_awaaz.db
SIMULATOR_DELAY_SECONDS=0.55
PUBLIC_BASE_URL=https://your-public-backend.example.com

# Groq streaming extraction (heuristic extraction works without this).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Bolna — see docs/bolna-setup.md. Never put real emergency numbers below.
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_LISTENER_AGENT_ID=
BOLNA_DISPATCH_AGENT_ID=
BOLNA_FROM_PHONE_NUMBER=
BOLNA_INBOUND_PHONE_NUMBER_ID=
BOLNA_WEBHOOK_SECRET=

# One allowlisted phone that the Live Console may ring for the judge demo.
# Falls back to FAMILY_DEMO_NUMBER when left empty.
LIVE_DEMO_CALLER_NUMBER=

# Keep false for the judge demo: the intake phone call is real, while the
# ambulance/police/family follow-up actions remain simulated.
LIVE_DISPATCH_ENABLED=false

# Only these configured stand-in numbers can receive calls.
AMBULANCE_DEMO_NUMBER=
POLICE_DEMO_NUMBER=
FAMILY_DEMO_NUMBER=
OUTBOUND_RATE_LIMIT=3
OUTBOUND_RATE_WINDOW_SECONDS=60

# SMS is mocked unless SMS_PROVIDER=twilio and real actions are enabled.
SMS_PROVIDER=mock
SMS_DEMO_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
